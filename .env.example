# =============================================================================
# IVAP 环境配置模板
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，禁止提交真实密钥。
# =============================================================================

# ---------- 应用 ----------
APP_NAME=Intelligent Vision Analysis Platform
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
# 生产环境必须替换成随机长字符串
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ---------- 路径（相对路径按项目根目录解析） ----------
LOG_DIR=backend/logs
UPLOAD_DIR=backend/uploads
VECTOR_DB_DIR=backend/vector_db

# ---------- 数据库（P1 暂不连接；P2 启用） ----------
# MySQL 示例（密码只写在本机 .env；测试由 pytest 自动覆盖为临时 SQLite）：
DATABASE_URL=mysql+pymysql://ivap:change-me@127.0.0.1:3306/ivap?charset=utf8mb4
DB_ECHO=false

# ---------- 文件限制 ----------
MAX_IMAGE_MB=20
MAX_DOCUMENT_MB=50

# ---------- 视觉模型 ----------
MODELS_CONFIG=backend/config/models.yaml
DEFAULT_MODEL=ece-yolo
# real | mock；mock 仅用于联调，响应会标记 is_mock=true
DETECTOR_MODE=real
MODEL_PRELOAD=true

# ---------- LLM（OpenAI 兼容） ----------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
LLM_MOCK=false

# ---------- Embedding ----------
# openai | local
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=32

# ---------- RAG ----------
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.25
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80

# ---------- Agent ----------
AGENT_MAX_STEPS=6

# ---------- Auth（预留，默认关闭） ----------
AUTH_ENABLED=false
