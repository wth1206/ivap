# Copy this file to .env.docker and fill real LLM/embedding keys.
# Run:
#   docker compose --env-file .env.docker up -d --build
#
# Never commit .env.docker.
ENV_FILE=.env.docker

# --- MySQL ---
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=ivap
MYSQL_USER=ivap
MYSQL_PASSWORD=replace-with-a-strong-app-password

# --- App ---
APP_NAME=IVAP
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO

# --- Detection ---
MODEL_PRELOAD=true
DETECTOR_MODE=real
DEFAULT_MODEL=ece-yolo

# --- LLM (required for analysis/chat/RAG answers) ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
LLM_MOCK=false

# --- Embedding ---
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16

# --- RAG ---
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.25
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# --- Agent ---
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SECONDS=180

# --- Optional build mirrors (uncomment/adjust for your network) ---
# PIP_INDEX_URL=https://pypi.org/simple
# TORCH_WHEEL_URL=https://download.pytorch.org/whl/cpu/torch-2.1.2%2Bcpu-cp39-cp39-linux_x86_64.whl
# TORCHVISION_WHEEL_URL=https://download.pytorch.org/whl/cpu/torchvision-0.16.2%2Bcpu-cp39-cp39-linux_x86_64.whl
